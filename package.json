{
  "name": "internship-management-platform",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "contracts:build": "pnpm --filter @imp/contracts build",
    "dev": "pnpm contracts:build && pnpm --parallel --filter \"./apps/*\" dev",
    "build": "pnpm contracts:build && pnpm --filter @imp/api build && pnpm --filter @imp/web build",
    "typecheck": "pnpm contracts:build && pnpm -r typecheck",
    "lint": "eslint .",
    "test": "pnpm -r test",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "verify": "pnpm lint && pnpm typecheck && pnpm test && pnpm build"
  },
  "devDependencies": {
    "eslint": "10.10.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.69.0"
  }
}
