# Salin ke .env lalu isi nilainya. Semua variabel di bawah divalidasi saat
# aplikasi start -- kalau ada yang kosong, proses berhenti dengan pesan jelas,
# bukan jalan diam-diam lalu error di tempat lain.

NODE_ENV=development
PORT=4000

# Cocok dengan docker-compose.yml di root repo.
DATABASE_URL=postgresql://imp:imp@localhost:5432/imp

# Wajib, minimal 32 karakter. Jangan pernah di-commit.
JWT_SECRET=
JWT_EXPIRES_IN=7d

CORS_ORIGIN=http://localhost:3000
